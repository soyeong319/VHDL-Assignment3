  <vhdl appearance="logisim_evolution" name="d_ff">LIBRARY ieee;&#13;
USE ieee.std_logic_1164.ALL;&#13;
USE ieee.numeric_std.ALL;&#13;
&#13;
ENTITY d_ff IS&#13;
  PORT (&#13;
    clk : IN  std_logic;&#13;
    d   : IN  std_logic;&#13;
    q   : OUT std_logic&#13;
  );&#13;
END ENTITY d_ff;&#13;
&#13;
ARCHITECTURE bhv OF d_ff IS&#13;
  SIGNAL q_internal : std_logic := '0';&#13;
BEGIN&#13;
  PROCESS(clk)&#13;
  BEGIN&#13;
    IF rising_edge(clk) THEN&#13;
      q_internal &lt;= d;&#13;
    END IF;&#13;
  END PROCESS;&#13;
&#13;
  q &lt;= q_internal;&#13;
END ARCHITECTURE bhv;&#13;
