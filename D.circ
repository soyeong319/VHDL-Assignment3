  <vhdl appearance="logisim_evolution" name="d_latch">LIBRARY ieee;&#13;
USE ieee.std_logic_1164.ALL;&#13;
USE ieee.numeric_std.ALL;&#13;
&#13;
ENTITY d_latch IS&#13;
  PORT (&#13;
    d  : IN  std_logic;&#13;
    en : IN  std_logic;&#13;
    q  : OUT std_logic;&#13;
    qn : OUT std_logic&#13;
  );&#13;
END ENTITY d_latch;&#13;
&#13;
ARCHITECTURE bhv OF d_latch IS&#13;
  SIGNAL q_internal : std_logic := '0';&#13;
BEGIN&#13;
  PROCESS(en, d)&#13;
  BEGIN&#13;
    IF (en = '1') THEN&#13;
      q_internal &lt;= d;&#13;
    END IF;&#13;
  END PROCESS;&#13;
&#13;
  q  &lt;= q_internal;&#13;
  qn &lt;= NOT q_internal;&#13;
END ARCHITECTURE bhv;&#13;
</vhdl>
